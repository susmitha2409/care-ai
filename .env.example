# CareSim AI - Environment Variables Template
# Copy this file to .env and configure your values:
# cp .env.example .env

# GROQ_API_KEY: Required for live LLM inference with Groq
# Obtain your free API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# GROQ_MODEL: Configurable model identifier
# Recommended: llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# CARESIM_DEMO_MODE: Set to true to force deterministic educational simulation without calling external APIs
CARESIM_DEMO_MODE=false

# CARESIM_DB_PATH: Path to local SQLite database file
CARESIM_DB_PATH=caresim.db
